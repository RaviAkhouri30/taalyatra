{
  "platform": {
    "apiRuntime": "node:22"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/icons/*",
      "*.{js,css,svg,png,jpg,jpeg,webp,ico,json,webmanifest,txt,xml,map}"
    ]
  },
  "routes": [
    {
      "route": "/runtime-config.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/admin.webmanifest",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ],
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
