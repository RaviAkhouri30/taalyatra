{
  "name": "taal-yatra",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:emulator": "ng serve --configuration emulator",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint --max-warnings 0",
    "lint:fix": "ng lint --fix",
    "lint:report": "eslint . -f json -o reports/eslint-report.json || true",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json && tsc -p tsconfig.rules.json",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "test:rules": "firebase emulators:exec --only firestore --project demo-taal-yatra \"vitest run --config vitest.rules.config.ts\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:firebase": "playwright test --config playwright.firebase.config.ts",
    "e2e:visual:update": "playwright test visual --update-snapshots",
    "e2e:install": "playwright install --with-deps chromium",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project taal-yatra",
    "sonar": "npm run lint:report && npx --yes @sonar/scan@5.0.2 -Dsonar.projectVersion=$npm_package_version",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\""
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@emailjs/browser": "5.0.3",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "firebase": "13.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "vite": "8.3.5"
  }
}
