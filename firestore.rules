rules_version = '2';

// Deny by default: only the matches below grant access (CLAUDE.md §10, ADR-0009).
// Tested by tests/rules/firestore.rules.spec.ts (`npm run test:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    // Public site content. Anyone may read it. Only the admin may change the documents the editor
    // covers, and only with the shape the site renders (0008). The seed script uses the Admin SDK,
    // which bypasses these rules.
    match /home/{section} {
      allow read: if true;
      allow update: if isAdmin()
        && section in ['hero', 'offer', 'audiences', 'experiences', 'rhythmGame', 'videos', 'team',
                       'contact', 'gallery', 'shows']
        && isValidHomeSection(request.resource.data, resource.data);
    }
    match /site/{document} {
      allow read: if true;
      allow create, update: if isAdmin()
        && ((document == 'config' && isValidSiteConfig(request.resource.data))
            || (document == 'visibility' && isValidVisibility(request.resource.data)));
    }
    match /pages/{page} {
      allow read: if true;
    }
    // Collections: the admin's publish writes them as numbered documents and deletes the numbers
    // it no longer uses (0009). The highest number allowed is the collection's item limit, which
    // mirrors COLLECTION_MAX_ITEMS (content-limits.constants.ts).
    match /showFormats/{item} {
      allow read: if true;
      allow create, update: if isAdmin() && isItemId(item, 20)
        && isValidShowFormat(request.resource.data);
      allow delete: if isAdmin();
    }
    match /videos/{item} {
      allow read: if true;
      allow create, update: if isAdmin() && isItemId(item, 60)
        && isValidVideo(request.resource.data);
      allow delete: if isAdmin();
    }
    match /gallery/{item} {
      allow read: if true;
      allow create, update: if isAdmin() && isItemId(item, 60)
        && isValidGalleryItem(request.resource.data);
      allow delete: if isAdmin();
    }
    match /team/{item} {
      allow read: if true;
      allow create, update: if isAdmin() && isItemId(item, 24)
        && isValidTeamMember(request.resource.data);
      allow delete: if isAdmin();
    }

    // The uploaded-image library: private to the admin. Visitors only ever get an image through a
    // published document that uses it (0009, D11).
    match /media/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isValidMedia(id, request.resource.data);
    }

    // The editor's drafts and publish history: the admin's working space, private to the admin.
    match /drafts/{key} {
      allow read, write: if isAdmin();
    }
    match /publishes/{id} {
      allow read, write: if isAdmin();
    }

    // Proposal requests. Visitors may create a well-formed one; no client may read, change or
    // delete them (they are read in the Firebase console).
    match /proposals/{proposal} {
      allow create: if isValidProposal(request.resource.data);
    }

    // The limits mirror PROPOSAL_MAX_LENGTH (proposal-limits.constants.ts); the rules tests build
    // their payloads from that constant, so the two can't drift apart unnoticed.
    function isValidProposal(data) {
      let fields = ['need', 'eventType', 'experience', 'groupSize', 'date', 'name', 'phone',
                    'email', 'message', 'createdAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && isText(data.need, 0, 100)
        && isText(data.eventType, 0, 100)
        && isText(data.experience, 0, 100)
        && isText(data.groupSize, 0, 100)
        && isText(data.date, 0, 100)
        && isText(data.name, 1, 100)
        && isText(data.phone, 1, 20)
        && isText(data.email, 0, 254)
        && isText(data.message, 0, 2000)
        // Stamped by the adapter with serverTimestamp(): a client can't backdate a record.
        && data.createdAt == request.time;
    }

    // The single admin account (0006, ADR-0012). A UID is an identifier, not a secret. The emulator
    // build seeds a user with the same UID, so the rules tests and smoke suite exercise this check.
    function isAdmin() {
      return request.auth != null && request.auth.uid == '5zsz2DlUaja2Ss7wbFTrpiMMROk2';
    }

    // The limits mirror CONTENT_MAX_LENGTH (content-limits.constants.ts); the rules tests read it.
    // The editor changes values, never the shape: the key set stays the one the site renders.
    function isValidHomeSection(data, current) {
      return data.keys().hasAll(current.keys())
        && data.keys().hasOnly(current.keys())
        && isOptionalText(data, 'eyebrow', 0, 60)
        && isOptionalText(data, 'title', 1, 120)
        && isOptionalText(data, 'highlight', 0, 80)
        && isOptionalText(data, 'lead', 0, 600);
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll(['brand', 'contact', 'copyrightYear'])
        && data.keys().hasOnly(['brand', 'contact', 'socials', 'promotion', 'copyrightYear',
                                'labels', 'credit'])
        && data.brand is map
        && isText(data.brand.name, 1, 60)
        && isText(data.brand.tagline, 0, 60)
        && data.contact is map
        && data.contact.phone is map
        && isText(data.contact.phone.display, 1, 20)
        && isText(data.contact.phone.e164, 8, 16)
        && isText(data.contact.email, 3, 254)
        && isText(data.contact.address, 1, 300)
        && data.copyrightYear is int
        && (!('socials' in data) || data.socials is list)
        && (!('promotion' in data) || isValidPromotion(data.promotion));
    }

    function isValidPromotion(promotion) {
      return promotion is map
        && promotion.keys().hasOnly(['label', 'subtitle', 'dismissLabel', 'live', 'startsOn',
                                     'endsOn'])
        && isText(promotion.label, 1, 40)
        && (!('live' in promotion) || promotion.live is bool)
        && (!('startsOn' in promotion) || isDateOrNull(promotion.startsOn))
        && (!('endsOn' in promotion) || isDateOrNull(promotion.endsOn));
    }

    // Keys mirror the HomeSection, SitePage and SiteWidget enums; the rules tests build the
    // document from them. Values are switches; the site treats anything but `false` as visible.
    function isValidVisibility(data) {
      return data.keys().hasOnly(['sections', 'pages', 'widgets'])
        && (!('sections' in data) || (data.sections is map
            && data.sections.keys().hasOnly(['marquee', 'trust', 'audiences', 'experiences',
                                             'shows', 'drumCircle', 'rhythmGame', 'videos',
                                             'gallery', 'philosophy', 'midCta', 'cities', 'how',
                                             'team', 'instagram', 'proof', 'faq'])))
        && (!('pages' in data) || (data.pages is map
            && data.pages.keys().hasOnly(['videos', 'team', 'shows', 'achievements'])))
        && (!('widgets' in data) || (data.widgets is map
            && data.widgets.keys().hasOnly(['assistant', 'actionBar', 'whatsApp', 'utilityBar',
                                            'intro'])));
    }

    // A collection's numbered document, from 001 up to its item limit.
    function isItemId(item, max) {
      return item.matches('^[0-9]{3}$') && int(item) >= 1 && int(item) <= max;
    }

    function isOrder(value) {
      return value is int && value >= 0;
    }

    function isValidImageFields(image) {
      return isText(image.src, 1, 500)
        && isText(image.alt, 0, 300)
        && image.width is int && image.width > 0
        && image.height is int && image.height > 0;
    }

    function isValidImage(image) {
      let fields = ['src', 'alt', 'width', 'height'];
      return image is map && image.keys().hasAll(fields) && image.keys().hasOnly(fields)
        && isValidImageFields(image);
    }

    function isValidGalleryItem(data) {
      let fields = ['src', 'alt', 'width', 'height', 'order'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isValidImageFields(data)
        && isOrder(data.order);
    }

    function isValidTeamMember(data) {
      let fields = ['name', 'role', 'bio', 'skills', 'funFact', 'photo', 'order'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isText(data.name, 1, 80)
        && isText(data.role, 0, 80)
        && isText(data.bio, 0, 400)
        && data.skills is list && data.skills.size() <= 12
        && isText(data.funFact, 0, 200)
        && isValidImage(data.photo)
        && isOrder(data.order);
    }

    function isValidShowFormat(data) {
      let fields = ['icon', 'title', 'text', 'ensemble', 'setLength', 'bestFor', 'image', 'featured',
                    'spotlight', 'order'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isText(data.icon, 1, 40)
        && isText(data.title, 1, 80)
        && isText(data.text, 0, 400)
        && isText(data.ensemble, 0, 80)
        && isText(data.setLength, 0, 40)
        && isText(data.bestFor, 0, 120)
        && isValidImage(data.image)
        && data.featured is bool
        && (data.spotlight == null || isValidSpotlight(data.spotlight))
        && isOrder(data.order);
    }

    function isValidSpotlight(spotlight) {
      let fields = ['eyebrow', 'title', 'primaryCta', 'secondaryCta'];
      return spotlight is map && spotlight.keys().hasAll(fields) && spotlight.keys().hasOnly(fields)
        && isText(spotlight.eyebrow, 0, 60)
        && isText(spotlight.title, 0, 120)
        && isText(spotlight.primaryCta, 0, 40)
        && isText(spotlight.secondaryCta, 0, 40);
    }

    function isValidVideo(data) {
      let fields = ['title', 'category', 'caption', 'image', 'duration', 'url', 'order'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isText(data.title, 1, 120)
        && isText(data.category, 0, 40)
        && isText(data.caption, 0, 200)
        && isValidImage(data.image)
        && isText(data.duration, 0, 12)
        && isText(data.url, 8, 500) && data.url.matches('^https://.*')
        && isOrder(data.order);
    }

    // The stored id must be the document's own, in the only folder the upload function signs for.
    function isValidMedia(id, data) {
      let fields = ['publicId', 'version', 'width', 'height', 'bytes', 'format', 'name',
                    'description', 'uploadedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && id.matches('^[0-9a-f-]{36}$')
        && data.publicId == 'taal-yatra/media/' + id
        && data.version is int && data.version > 0
        && data.width is int && data.width > 0
        && data.height is int && data.height > 0
        && data.bytes is int && data.bytes >= 0
        && isText(data.format, 1, 10)
        && isText(data.name, 0, 200)
        && isText(data.description, 0, 300)
        && isText(data.uploadedAt, 1, 40);
    }

    function isDateOrNull(value) {
      return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isOptionalText(data, field, min, max) {
      return !(field in data) || isText(data[field], min, max);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
  }
}
