rules_version = '2';

// Deny by default: only the matches below grant access (CLAUDE.md §10, ADR-0009).
// Tested by tests/rules/firestore.rules.spec.ts (`npm run test:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    // Public site content. Anyone may read it. The owner, and a manager on the pages they may
    // publish (0019), change the documents the editor covers, only with the shape the site renders
    // (0008). The seed script uses the Admin SDK, which bypasses these rules.
    match /home/{section} {
      allow read: if true;
      allow update: if section in homePages()
        && canPublishHere(homePages()[section], 'home/' + section)
        && isValidHomeSection(request.resource.data, resource.data);
    }
    match /site/{document} {
      allow read: if true;
      allow create: if isOwner() && isValidSiteDocument(document, request.resource.data);
      allow update: if isValidSiteDocument(document, request.resource.data)
        && (isOwner()
            || (document == 'visibility' && canPublishHere('visibility', 'site/visibility'))
            || (document == 'theme' && canPublishHere('theme', 'site/theme'))
            // Offer, Business details and Contact & social links share this document: a manager
            // changes only the parts of the pages they may publish.
            || (document == 'config' && isManager()
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(publishableConfigKeys()))
            // A manager who can approve: the parts of the pages they see, with their approval (0023).
            || (document == 'config' && selfApprovesShared('site/config')
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(approvableConfigKeys())));
    }
    match /pages/{page} {
      allow read: if true;
    }
    // Collections: a publish writes them as numbered documents and deletes the numbers it no
    // longer uses (0009). The highest number allowed is the collection's item limit, which
    // mirrors COLLECTION_MAX_ITEMS (content-limits.constants.ts).
    match /showFormats/{item} {
      allow read: if true;
      allow create, update: if canPublishHere('shows', 'showFormats') && isItemId(item, 20)
        && isValidShowFormat(request.resource.data);
      allow delete: if canPublishHere('shows', 'showFormats');
    }
    match /videos/{item} {
      allow read: if true;
      allow create, update: if canPublishHere('videos', 'videos') && isItemId(item, 60)
        && isValidVideo(request.resource.data);
      allow delete: if canPublishHere('videos', 'videos');
    }
    match /gallery/{item} {
      allow read: if true;
      allow create, update: if canPublishHere('gallery', 'gallery') && isItemId(item, 60)
        && isValidGalleryItem(request.resource.data);
      allow delete: if canPublishHere('gallery', 'gallery');
    }
    match /team/{item} {
      allow read: if true;
      allow create, update: if canPublishHere('team', 'team') && isItemId(item, 24)
        && isValidTeamMember(request.resource.data);
      allow delete: if canPublishHere('team', 'team');
    }

    // The uploaded-image library. Visitors only ever get an image through a published document
    // that uses it (0009, D11). A manager picks from it, and adds to it when uploads are on; only
    // the owner deletes, since a deleted photo disappears from the live site (0019).
    match /media/{id} {
      allow read: if isOwner() || isManager();
      allow delete: if isOwner();
      allow create, update: if (isOwner() || (isManager() && role().uploads == true))
        && isValidMedia(id, request.resource.data);
    }

    // The editor's drafts: one shared working copy (0019 decision 4). Managers read them all, as
    // the preview does; they write only drafts of pages they can see, signed with their own id,
    // and never one waiting for approval (`locks`).
    match /drafts/{key} {
      allow read: if isOwner() || isManager();
      allow write: if isOwner();
      allow create, update: if isManager()
        && isValidManagerDraft(key, request.resource.data)
        && !exists(/databases/$(database)/documents/locks/$(key));
      allow delete: if isManager()
        && canDraft(resource.data.path)
        && !exists(/databases/$(database)/documents/locks/$(key));
    }
    // Publish history. A manager's publish adds a record naming only pages they may publish, and
    // never deletes one; the owner's publishes trim the history to its limit.
    match /publishes/{id} {
      allow read: if isOwner() || isManager();
      allow write: if isOwner();
      allow create: if isManager()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.changed is list
        && (request.resource.data.changed.hasOnly(publishablePaths())
            // Pages that need approval, approved by the manager themselves, saying so (0023).
            || (role().get('canApprove', false) == true
                && isValidSelfApproval(request.resource.data.get('selfApproval', null))
                && request.resource.data.changed.hasOnly(approvablePaths())));
    }
    // A manager's self-approval marker (0023 D5): rewritten with every self-approved publish, in
    // the same commit, pointing at that publish's new history record. Live writes to pages that
    // need approval check it, so none goes live without its record.
    match /selfApprovals/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isManager() && request.auth.uid == uid
        && role().get('canApprove', false) == true
        && request.resource.data.keys().hasAll(['record', 'paths'])
        && request.resource.data.keys().hasOnly(['record', 'paths'])
        && request.resource.data.paths is list
        && request.resource.data.paths.hasOnly(approvablePaths())
        && isNewSelfApprovedRecord(request.resource.data.record);
    }

    // Who may do what (0019). Only the owner adds, changes or removes a manager; a manager reads
    // only their own record. The owner never has one: they are fixed below (decision 1).
    match /roles/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow delete: if isOwner();
      allow create, update: if isOwner() && uid != ownerUid() && isValidRole(request.resource.data);
    }
    // Changes sent for approval. A manager sends and withdraws their own; the owner approves or
    // sends back, changing only the answer.
    match /approvals/{id} {
      allow read: if isOwner() || isManager();
      allow create: if isManager() && isValidApproval(request.resource.data);
      allow delete: if isOwner()
        || (isManager() && resource.data.by == request.auth.uid);
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'answer', 'answeredAt'])
        && request.resource.data.status in ['approved', 'sent-back']
        && isText(request.resource.data.get('answer', ''), 0, 500);
    }
    // One per draft waiting for approval, so the manager can't change it after sending (decision
    // 5). Created with its waiting request, and removed when the request is answered or withdrawn.
    match /locks/{key} {
      allow read: if isOwner() || isManager();
      allow write: if isOwner();
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['approval'])
        && request.resource.data.approval is string
        && isOwnWaitingApproval(request.resource.data.approval);
      allow delete: if isManager()
        && !existsAfter(/databases/$(database)/documents/approvals/$(resource.data.approval));
    }
    // The editor's own notes (0016 V13): when the last backup was made, so every device agrees.
    // Only known documents, each with only its known field.
    match /adminState/{document} {
      allow read: if canUseArea('backups');
      allow create, update: if canUseArea('backups')
        && document == 'backups'
        && request.resource.data.keys().hasOnly(['lastAt'])
        && isText(request.resource.data.lastAt, 20, 40);
    }

    // Proposal requests. Visitors may create a well-formed one and nothing else. The Leads page
    // (0018) reads them and changes only their status, signed with the changer's own email (0022);
    // the owner, or a manager given Leads. Deleting one, on a customer's request, stays the owner's.
    match /proposals/{proposal} {
      allow create: if isValidProposal(request.resource.data);
      allow read: if canUseArea('leads');
      allow delete: if isOwner();
      allow update: if canUseArea('leads')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'statusAt', 'statusBy'])
        && request.resource.data.status in ['new', 'contacted', 'won', 'lost']
        && isText(request.resource.data.statusAt, 20, 40)
        && request.resource.data.get('statusBy', null) == request.auth.token.email;
    }

    // Anonymous visit counts (0018). A visitor adds one visit: the page arrived on, the kind of
    // device and the server's time, nothing that identifies anyone. The admin area adds each
    // finished day up into `visitDays` and removes that day's single visits.
    match /visits/{visit} {
      allow create: if isValidVisit(request.resource.data);
      allow read, delete: if canUseArea('visits');
    }
    // Created once per day and never changed, so a second device adding the same day up can't
    // overwrite the first with a different total.
    match /visitDays/{day} {
      allow read: if canUseArea('visits');
      allow create: if canUseArea('visits')
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidVisitDay(request.resource.data);
    }

    // Anonymous speed reports from real visits (0012). Visitors may create a well-formed one and
    // nothing else; only the admin reads or deletes them. Nothing in them identifies anyone.
    match /vitals/{report} {
      allow create: if isValidVitals(request.resource.data);
      allow read, delete: if canUseArea('visits');
    }

    // The limits mirror PROPOSAL_MAX_LENGTH (proposal-limits.constants.ts); the rules tests build
    // their payloads from that constant, so the two can't drift apart unnoticed.
    function isValidProposal(data) {
      let fields = ['need', 'eventType', 'experience', 'groupSize', 'date', 'name', 'phone',
                    'email', 'message', 'createdAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && isText(data.need, 0, 100)
        && isText(data.eventType, 0, 100)
        && isText(data.experience, 0, 100)
        && isText(data.groupSize, 0, 100)
        && isText(data.date, 0, 100)
        && isText(data.name, 1, 100)
        && isText(data.phone, 1, 20)
        // Required since 1.8.1, so every request can be answered by email (and auto-replied to).
        && isText(data.email, 3, 254)
        && data.email.matches('[^@ ]+@[^@ ]+')
        && isText(data.message, 0, 2000)
        // Stamped by the adapter with serverTimestamp(): a client can't backdate a record.
        && data.createdAt == request.time;
    }

    function isValidVitals(data) {
      let fields = ['page', 'device', 'connection', 'lcp', 'fcp', 'ttfb', 'ready', 'cls',
                    'createdAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.page in ['/', '/shows', '/videos', '/team', '/achievements']
        && data.device in ['phone', 'tablet', 'desktop']
        && data.connection in ['', 'slow-2g', '2g', '3g', '4g']
        && isMsOrNull(data.lcp)
        && isMsOrNull(data.fcp)
        && isMsOrNull(data.ttfb)
        && isMsOrNull(data.ready)
        && data.cls is number && data.cls >= 0 && data.cls <= 10
        // Stamped by the adapter with serverTimestamp(): a client can't backdate a report.
        && data.createdAt == request.time;
    }

    // The pages and devices mirror VISIT_PAGES and VISIT_DEVICES (visit.constants.ts).
    function isValidVisit(data) {
      return data.keys().hasAll(['page', 'device', 'createdAt'])
        && data.keys().hasOnly(['page', 'device', 'createdAt'])
        && data.page in ['/', '/shows', '/videos', '/team', '/achievements']
        && data.device in ['phone', 'tablet', 'desktop']
        // Stamped by the adapter with serverTimestamp(): a client can't backdate a visit.
        && data.createdAt == request.time;
    }

    // Totals only: the rules can't add up the maps' numbers, so they check their shape.
    function isValidVisitDay(data) {
      return data.keys().hasAll(['total', 'pages', 'devices'])
        && data.keys().hasOnly(['total', 'pages', 'devices'])
        && data.total is int && data.total >= 0
        && data.pages is map
        && data.pages.keys().hasOnly(['/', '/shows', '/videos', '/team', '/achievements'])
        && data.devices is map
        && data.devices.keys().hasOnly(['phone', 'tablet', 'desktop']);
    }

    function isMsOrNull(value) {
      return value == null || (value is int && value >= 0 && value <= 120000);
    }

    // The owner's account (0006, ADR-0012): fixed here, so nothing on Team access can lock them
    // out (0019 decision 1). A UID is an identifier, not a secret. The emulator build seeds a user
    // with the same UID, so the rules tests and smoke suite exercise this check.
    function ownerUid() {
      return '5zsz2DlUaja2Ss7wbFTrpiMMROk2';
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    function rolePath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    // Someone the owner added on Team access (0019). Read on every request, so removing a manager
    // or changing a setting takes effect at once.
    function isManager() {
      return request.auth != null && !isOwner() && exists(rolePath());
    }

    function role() {
      return get(rolePath()).data;
    }

    // A page's setting for the signed-in manager. Keys mirror the EditorTab enum; a page missing
    // from the record needs approval, the default (decision 3).
    function pageSetting(page) {
      return role().pages.get(page, 'approval');
    }

    function canSee(page) {
      return isOwner() || (isManager() && pageSetting(page) != 'hidden');
    }

    // One of the owner's areas (0022): the owner, or a manager whose role turns it on. A role
    // without `areas` has none, so managers added before 2.3.0 change nothing.
    function canUseArea(area) {
      return isOwner() || (isManager() && role().get('areas', {}).get(area, false) == true);
    }

    // A publish record made in this commit, by this manager, as a self-approval (0023).
    function isNewSelfApprovedRecord(id) {
      let path = /databases/$(database)/documents/publishes/$(id);
      return id is string && !exists(path) && existsAfter(path)
        && getAfter(path).data.by == request.auth.uid
        && getAfter(path).data.get('selfApproval', null) is map;
    }

    // The title and note a manager gives their own approval; both may be empty (0023 D2).
    function isValidSelfApproval(approval) {
      return approval is map && approval.keys().hasOnly(['title', 'note'])
        && isText(approval.get('title', ''), 0, 80) && isText(approval.get('note', ''), 0, 500);
    }

    // A page the account publishes as it is, or a manager who can approve publishes with their
    // own approval in the same commit (0023 D5).
    function canPublishHere(page, path) {
      return canPublish(page) || (isManager() && pageSetting(page) == 'approval'
                                  && selfApprovesShared(path));
    }

    // This manager's marker changed in this commit (so it can't be an old one) and names `path`.
    function selfApprovesShared(path) {
      let marker = /databases/$(database)/documents/selfApprovals/$(request.auth.uid);
      return isManager() && role().get('canApprove', false) == true
        && existsAfter(marker) && path in getAfter(marker).data.paths
        && (!exists(marker) || get(marker).data.record != getAfter(marker).data.record);
    }

    function canPublish(page) {
      return isOwner() || (isManager() && pageSetting(page) == 'publish');
    }

    // The editor page each home section belongs to.
    function homePages() {
      return {
        'hero': 'hero', 'offer': 'offer', 'audiences': 'audiences', 'experiences': 'experiences',
        'shows': 'shows', 'drumCircle': 'drum-circle', 'rhythmGame': 'rhythm-game',
        'videos': 'videos', 'gallery': 'gallery', 'team': 'team', 'contact': 'proposal-form'
      };
    }

    // The editor page each drafted document belongs to, but `site/config`, which three share.
    // Paths mirror ContentPath (content-path.enum.ts).
    function draftPages() {
      return {
        'home/hero': 'hero', 'home/offer': 'offer', 'home/audiences': 'audiences',
        'home/experiences': 'experiences', 'home/shows': 'shows', 'showFormats': 'shows',
        'home/drumCircle': 'drum-circle', 'home/rhythmGame': 'rhythm-game',
        'home/videos': 'videos', 'videos': 'videos', 'home/gallery': 'gallery',
        'gallery': 'gallery', 'home/team': 'team', 'team': 'team',
        'home/contact': 'proposal-form', 'site/visibility': 'visibility', 'site/theme': 'theme'
      };
    }

    function canDraft(path) {
      return path is string
        && ((path == 'site/config' && (canSee('offer') || canSee('business') || canSee('contact')))
            || (path in draftPages() && canSee(draftPages()[path])));
    }

    // The parts of `site/config` a manager may change: those of the pages they may publish. Called
    // for managers only, with their settings read once (a rule may only look up so many documents).
    function publishableConfigKeys() {
      let pages = role().pages;
      return pathsIf(pages, 'business', ['brand'])
        .concat(pathsIf(pages, 'offer', ['promotion']))
        .concat(pathsIf(pages, 'contact', ['contact', 'socials', 'copyrightYear']));
    }

    // `paths` when the manager may publish `page`, else nothing.
    function pathsIf(pages, page, paths) {
      return pages.get(page, 'approval') == 'publish' ? paths : [];
    }

    // `paths` when the manager sees `page` at all, else nothing (0023).
    function pathsIfSeen(pages, page, paths) {
      return pages.get(page, 'approval') != 'hidden' ? paths : [];
    }

    // The parts of `site/config` a manager who can approve may change: those of the pages they see.
    function approvableConfigKeys() {
      let pages = role().pages;
      return pathsIfSeen(pages, 'business', ['brand'])
        .concat(pathsIfSeen(pages, 'offer', ['promotion']))
        .concat(pathsIfSeen(pages, 'contact', ['contact', 'socials', 'copyrightYear']));
    }

    // The documents a manager who can approve may name in a self-approved record: their pages'.
    function approvablePaths() {
      let pages = role().pages;
      return pathsIfSeen(pages, 'hero', ['home/hero'])
        .concat(pathsIfSeen(pages, 'offer', ['home/offer', 'site/config']))
        .concat(pathsIfSeen(pages, 'audiences', ['home/audiences']))
        .concat(pathsIfSeen(pages, 'experiences', ['home/experiences']))
        .concat(pathsIfSeen(pages, 'shows', ['home/shows', 'showFormats']))
        .concat(pathsIfSeen(pages, 'drum-circle', ['home/drumCircle']))
        .concat(pathsIfSeen(pages, 'rhythm-game', ['home/rhythmGame']))
        .concat(pathsIfSeen(pages, 'videos', ['home/videos', 'videos']))
        .concat(pathsIfSeen(pages, 'gallery', ['home/gallery', 'gallery']))
        .concat(pathsIfSeen(pages, 'team', ['home/team', 'team']))
        .concat(pathsIfSeen(pages, 'proposal-form', ['home/contact']))
        .concat(pathsIfSeen(pages, 'business', ['site/config']))
        .concat(pathsIfSeen(pages, 'contact', ['site/config']))
        .concat(pathsIfSeen(pages, 'visibility', ['site/visibility']))
        .concat(pathsIfSeen(pages, 'theme', ['site/theme']));
    }

    // The documents a manager may name in a publish record. Called for managers only.
    function publishablePaths() {
      let pages = role().pages;
      return pathsIf(pages, 'hero', ['home/hero'])
        .concat(pathsIf(pages, 'offer', ['home/offer', 'site/config']))
        .concat(pathsIf(pages, 'audiences', ['home/audiences']))
        .concat(pathsIf(pages, 'experiences', ['home/experiences']))
        .concat(pathsIf(pages, 'shows', ['home/shows', 'showFormats']))
        .concat(pathsIf(pages, 'drum-circle', ['home/drumCircle']))
        .concat(pathsIf(pages, 'rhythm-game', ['home/rhythmGame']))
        .concat(pathsIf(pages, 'videos', ['home/videos', 'videos']))
        .concat(pathsIf(pages, 'gallery', ['home/gallery', 'gallery']))
        .concat(pathsIf(pages, 'team', ['home/team', 'team']))
        .concat(pathsIf(pages, 'proposal-form', ['home/contact']))
        .concat(pathsIf(pages, 'business', ['site/config']))
        .concat(pathsIf(pages, 'contact', ['site/config']))
        .concat(pathsIf(pages, 'visibility', ['site/visibility']))
        .concat(pathsIf(pages, 'theme', ['site/theme']));
    }

    // A draft id is its path with `/` as `__` (draftId in i-draft.ts).
    function isValidManagerDraft(key, data) {
      let fields = ['path', 'content', 'savedAt', 'savedBy'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && canDraft(data.path)
        && key == data.path.replace('/', '__')
        && data.content is map
        && isText(data.savedAt, 20, 40)
        && data.savedBy == request.auth.uid;
    }

    // Keys mirror the EditorTab enum, and values PageAccess.
    function isValidRole(data) {
      let fields = ['email', 'pages', 'uploads', 'addedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(['areas', 'canApprove']))
        && (!('canApprove' in data) || data.canApprove is bool)
        // Keys mirror ManagerArea (manager-area.enum.ts).
        && (!('areas' in data) || (data.areas is map
            && data.areas.keys().hasOnly(['leads', 'visits', 'backups', 'goingBack'])
            && data.areas.values().hasOnly([true, false])))
        && isText(data.email, 3, 254)
        && data.pages is map
        && data.pages.keys().hasOnly(['hero', 'offer', 'audiences', 'experiences', 'shows',
                                      'drum-circle', 'rhythm-game', 'videos', 'gallery', 'team',
                                      'proposal-form', 'business', 'contact', 'visibility',
                                      'theme'])
        && data.pages.values().hasOnly(['hidden', 'approval', 'publish'])
        && data.uploads is bool
        && isText(data.addedAt, 20, 40);
    }

    function isValidApproval(data) {
      let fields = ['by', 'email', 'paths', 'note', 'sentAt', 'status'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.by == request.auth.uid
        && isText(data.email, 0, 254)
        && data.paths is list && data.paths.size() >= 1 && data.paths.size() <= 20
        && isText(data.note, 0, 500)
        && isText(data.sentAt, 20, 40)
        && data.status == 'waiting';
    }

    // Checked against the state after the commit: the request is sent in the same commit.
    function isOwnWaitingApproval(id) {
      let path = /databases/$(database)/documents/approvals/$(id);
      return existsAfter(path)
        && getAfter(path).data.by == request.auth.uid
        && getAfter(path).data.status == 'waiting';
    }

    function isValidSiteDocument(document, data) {
      return (document == 'config' && isValidSiteConfig(data))
        || (document == 'visibility' && isValidVisibility(data))
        || (document == 'theme' && isValidTheme(data));
    }

    // The limits mirror CONTENT_MAX_LENGTH (content-limits.constants.ts); the rules tests read it.
    // The editor changes values, never the shape: the key set stays the one the site renders.
    function isValidHomeSection(data, current) {
      return data.keys().hasAll(current.keys())
        && data.keys().hasOnly(current.keys())
        && isOptionalText(data, 'eyebrow', 0, 60)
        && isOptionalText(data, 'title', 1, 120)
        && isOptionalText(data, 'highlight', 0, 80)
        && isOptionalText(data, 'lead', 0, 600);
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll(['brand', 'contact', 'copyrightYear'])
        && data.keys().hasOnly(['brand', 'contact', 'socials', 'promotion', 'copyrightYear',
                                'labels', 'credit'])
        && data.brand is map
        && isText(data.brand.name, 1, 60)
        && isText(data.brand.tagline, 0, 60)
        && data.contact is map
        && data.contact.phone is map
        && isText(data.contact.phone.display, 1, 20)
        && isText(data.contact.phone.e164, 8, 16)
        && isText(data.contact.email, 3, 254)
        && isText(data.contact.address, 1, 300)
        && data.copyrightYear is int
        && (!('socials' in data) || data.socials is list)
        && (!('promotion' in data) || isValidPromotion(data.promotion));
    }

    function isValidPromotion(promotion) {
      return promotion is map
        && promotion.keys().hasOnly(['label', 'subtitle', 'dismissLabel', 'live', 'startsOn',
                                     'endsOn'])
        && isText(promotion.label, 1, 40)
        && (!('live' in promotion) || promotion.live is bool)
        && (!('startsOn' in promotion) || isDateOrNull(promotion.startsOn))
        && (!('endsOn' in promotion) || isDateOrNull(promotion.endsOn));
    }

    // Keys mirror the HomeSection, SitePage and SiteWidget enums; the rules tests build the
    // document from them. Values are switches; the site treats anything but `false` as visible.
    function isValidVisibility(data) {
      return data.keys().hasOnly(['sections', 'pages', 'widgets', 'folded'])
        && (!('sections' in data) || (data.sections is map
            && data.sections.keys().hasOnly(['marquee', 'trust', 'audiences', 'experiences',
                                             'shows', 'drumCircle', 'rhythmGame', 'videos',
                                             'gallery', 'philosophy', 'midCta', 'cities', 'how',
                                             'team', 'instagram', 'proof', 'faq'])))
        && (!('pages' in data) || (data.pages is map
            && data.pages.keys().hasOnly(['videos', 'team', 'shows', 'achievements'])))
        && (!('widgets' in data) || (data.widgets is map
            && data.widgets.keys().hasOnly(['assistant', 'actionBar', 'whatsApp', 'utilityBar',
                                            'intro'])))
        // Foldable sections mirror FOLD_DEFAULTS, and the modes FoldMode (0015).
        && (!('folded' in data) || (data.folded is map
            && data.folded.keys().hasOnly(['philosophy', 'cities', 'how', 'instagram', 'proof',
                                           'faq'])
            && data.folded.values().hasOnly(['never', 'phone', 'desktop', 'always'])));
    }

    // The site's theme (0021, ADR-0019). Every field is optional: a missing one keeps today's look.
    // Colours mirror HEX_COLOUR (colour.util.ts) and the lists the Theme* enums. The rules check the
    // shape only; contrast is checked by the admin before publishing, and again by the site.
    function isValidTheme(data) {
      let colours = ['background', 'cards', 'text', 'quietText', 'accent', 'secondAccent'];
      return data.keys().hasOnly(colours.concat(['preset', 'backdrop', 'textSize',
                                                 'headingWeight', 'fonts']))
        && isColourOrMissing(data, 'background') && isColourOrMissing(data, 'cards')
        && isColourOrMissing(data, 'text') && isColourOrMissing(data, 'quietText')
        && isColourOrMissing(data, 'accent') && isColourOrMissing(data, 'secondAccent')
        && isOneOfOrMissing(data, 'preset',
                            ['warm-night', 'daylight', 'festival', 'high-contrast', 'custom'])
        && isOneOfOrMissing(data, 'backdrop', ['plain', 'gradient'])
        && isOneOfOrMissing(data, 'textSize', ['smaller', 'standard', 'larger'])
        && isOneOfOrMissing(data, 'headingWeight', ['bold', 'extra-bold'])
        && isOneOfOrMissing(data, 'fonts', ['bricolage-dm', 'fraunces-inter', 'playfair-source',
                                            'poppins-nunito', 'space-work', 'yatra-mukta']);
    }

    function isColourOrMissing(data, field) {
      return !(field in data) || (data[field] is string && data[field].matches('^#[0-9a-f]{6}$'));
    }

    function isOneOfOrMissing(data, field, values) {
      return !(field in data) || (data[field] is string && data[field] in values);
    }

    // A collection's numbered document, from 001 up to its item limit.
    function isItemId(item, max) {
      return item.matches('^[0-9]{3}$') && int(item) >= 1 && int(item) <= max;
    }

    function isOrder(value) {
      return value is int && value >= 0;
    }

    function isValidImageFields(image) {
      return isText(image.src, 1, 500)
        && isText(image.alt, 0, 300)
        && image.width is int && image.width > 0
        && image.height is int && image.height > 0;
    }

    function isValidImage(image) {
      let fields = ['src', 'alt', 'width', 'height'];
      return image is map && image.keys().hasAll(fields) && image.keys().hasOnly(fields)
        && isValidImageFields(image);
    }

    function isValidGalleryItem(data) {
      let fields = ['src', 'alt', 'width', 'height', 'order'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isValidImageFields(data)
        && isOrder(data.order);
    }

    function isValidTeamMember(data) {
      let fields = ['name', 'role', 'bio', 'skills', 'funFact', 'photo', 'order'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isText(data.name, 1, 80)
        && isText(data.role, 0, 80)
        && isText(data.bio, 0, 400)
        && data.skills is list && data.skills.size() <= 12
        && isText(data.funFact, 0, 200)
        && isValidImage(data.photo)
        && isOrder(data.order);
    }

    function isValidShowFormat(data) {
      let fields = ['icon', 'title', 'text', 'ensemble', 'setLength', 'bestFor', 'image', 'featured',
                    'spotlight', 'order'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isText(data.icon, 1, 40)
        && isText(data.title, 1, 80)
        && isText(data.text, 0, 400)
        && isText(data.ensemble, 0, 80)
        && isText(data.setLength, 0, 40)
        && isText(data.bestFor, 0, 120)
        && isValidImage(data.image)
        && data.featured is bool
        && (data.spotlight == null || isValidSpotlight(data.spotlight))
        && isOrder(data.order);
    }

    function isValidSpotlight(spotlight) {
      let fields = ['eyebrow', 'title', 'primaryCta', 'secondaryCta'];
      return spotlight is map && spotlight.keys().hasAll(fields) && spotlight.keys().hasOnly(fields)
        && isText(spotlight.eyebrow, 0, 60)
        && isText(spotlight.title, 0, 120)
        && isText(spotlight.primaryCta, 0, 40)
        && isText(spotlight.secondaryCta, 0, 40);
    }

    function isValidVideo(data) {
      let fields = ['title', 'category', 'caption', 'image', 'duration', 'url', 'order'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isText(data.title, 1, 120)
        && isText(data.category, 0, 40)
        && isText(data.caption, 0, 200)
        && isValidImage(data.image)
        && isText(data.duration, 0, 12)
        && isText(data.url, 8, 500) && data.url.matches('^https://.*')
        && isOrder(data.order);
    }

    // The stored id must be the document's own, in the only folder the upload function signs for.
    function isValidMedia(id, data) {
      let fields = ['publicId', 'version', 'width', 'height', 'bytes', 'format', 'name',
                    'description', 'uploadedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && id.matches('^[0-9a-f-]{36}$')
        && data.publicId == 'taal-yatra/media/' + id
        && data.version is int && data.version > 0
        && data.width is int && data.width > 0
        && data.height is int && data.height > 0
        && data.bytes is int && data.bytes >= 0
        && isText(data.format, 1, 10)
        && isText(data.name, 0, 200)
        && isText(data.description, 0, 300)
        && isText(data.uploadedAt, 1, 40);
    }

    function isDateOrNull(value) {
      return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isOptionalText(data, field, min, max) {
      return !(field in data) || isText(data[field], min, max);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
  }
}
