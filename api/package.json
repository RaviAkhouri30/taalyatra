    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/functions": "4.17.0",
    "jose": "6.2.15",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
