{
  "name": "taal-yatra-api",
  "version": "1.0.0",
  "description": "Signs and deletes media uploads for the Taal Yatra editor (ADR-0017).",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "main": "dist/functions/*.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
